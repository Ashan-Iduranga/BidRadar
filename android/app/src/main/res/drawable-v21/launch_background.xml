<?xml version="1.0" encoding="utf-8"?>
<!-- BidRadar splash: the Azure Mint hero gradient with the radar-arc mark centred. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#FF0A3D91"
                android:centerColor="#FF0B5ED7"
                android:endColor="#FF08705F"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher_foreground" />
    </item>
</layer-list>
