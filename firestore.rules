rules_version = '2';

// BidRadar Firestore security rules (Phase 1: roles and invites).
// Model: one company per account. companies/{id}.members is a map
// uid -> "owner" | "bid_manager". Only members read company data;
// only the owner edits the profile and writes approvals.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function company(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId)).data;
    }

    function isMember(companyId) {
      return signedIn() && request.auth.uid in company(companyId).members;
    }

    function isOwner(companyId) {
      return signedIn() && company(companyId).ownerUid == request.auth.uid;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    // Top-level fields an update adds, removes or changes.
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function unchanged(keys) {
      return !changedKeys().hasAny(keys);
    }

    // A new bid starts in Watching, not approved, with no checklist, no
    // outcome and no owner's note. Anyone asking at once must be the caller.
    function newBidIsUnapproved() {
      let b = request.resource.data;
      return b.stage == 'watching'
        && ((b.approval == 'none' && b.get('requestedBy', null) == null)
          || (b.approval == 'pending'
            && b.get('requestedBy', null) == request.auth.uid))
        && b.get('approvalNote', '') == ''
        && b.get('tasks', []).size() == 0
        && b.get('taskDone', {}).size() == 0
        && b.get('lossReasons', []).size() == 0
        && b.ownerUid == request.auth.uid;
    }

    // What a bid manager may change on an existing bid:
    // - ask for approval: none or rejected to pending, in Watching, as
    //   themself;
    // - move on once the owner approved: Preparing to Submitted, then Won
    //   or Lost, with loss reasons only when Lost;
    // - work the checklist: tick tasks (taskDone) and add tasks, never
    //   remove them.
    // Everything else (approval decisions, the owner's note, the verdict
    // and the tender facts) is the owner's.
    function bidManagerMayUpdate() {
      let old = resource.data;
      let b = request.resource.data;
      let keys = changedKeys();
      return keys.hasOnly(['approval', 'requestedBy', 'stage', 'lossReasons',
          'tasks', 'taskDone', 'updatedAt'])
        && (!('approval' in keys)
          || (old.stage == 'watching'
            && old.approval in ['none', 'rejected']
            && b.approval == 'pending'))
        && (!('requestedBy' in keys)
          || (b.approval == 'pending' && b.requestedBy == request.auth.uid))
        && (!('stage' in keys)
          || (old.approval == 'approved'
            && ((old.stage == 'preparing' && b.stage == 'submitted')
              || (old.stage == 'submitted' && b.stage in ['won', 'lost']))))
        && (!('lossReasons' in keys) || b.stage == 'lost')
        && (!('tasks' in keys) || b.tasks.size() > old.tasks.size());
    }

    // The caller holds an invite to this company.
    function invitedTo(companyId) {
      let path = /databases/$(database)/documents/invites/$(myEmail());
      return signedIn() && exists(path)
        && get(path).data.companyId == companyId;
    }

    // users/{uid}: which company the user belongs to. Pointing it at a
    // company you are not a member of grants nothing.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // invites/{email}: owner invites a bid manager by email.
    match /invites/{email} {
      allow read: if signedIn()
        && (myEmail() == email || isOwner(resource.data.companyId));
      allow create: if isOwner(request.resource.data.companyId)
        && request.resource.data.email == email
        && request.resource.data.role == 'bid_manager'
        && request.resource.data.invitedBy == request.auth.uid;
      allow delete: if signedIn()
        && (myEmail() == email || isOwner(resource.data.companyId));
      // The owner of the inviting company may send it again. An invite
      // from another company cannot be taken over.
      allow update: if isOwner(resource.data.companyId)
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.email == email
        && request.resource.data.role == 'bid_manager'
        && request.resource.data.invitedBy == request.auth.uid;
    }

    match /companies/{companyId} {
      allow read: if isMember(companyId);
      // The creator must name themself as owner and owner-member.
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.members[request.auth.uid] == 'owner';
      allow update: if (isOwner(companyId)
          && request.resource.data.ownerUid == resource.data.ownerUid)
        // An invited user may add only themself, only as bid manager.
        || (invitedTo(companyId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['members', 'memberEmails'])
          && request.resource.data.members.diff(resource.data.members)
               .affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.members[request.auth.uid] == 'bid_manager'
          && request.resource.data.memberEmails.diff(resource.data.memberEmails)
               .affectedKeys().hasOnly([request.auth.uid]));
      allow delete: if false;
    }

    match /profiles/{companyId} {
      allow read: if isMember(companyId);
      allow write: if isOwner(companyId);
    }

    // Public tender data, shared across companies. Written by the app's sync.
    match /tenders/{tenderId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if false;
    }

    // Audit trail: append-only.
    match /verdicts/{verdictId} {
      allow read: if isMember(resource.data.companyId);
      allow create: if isMember(request.resource.data.companyId);
      allow update, delete: if false;
    }

    match /bids/{bidId} {
      // Reading a bid that does not exist reveals nothing, and lets a
      // removed bid show as removed instead of failing.
      allow read: if resource == null || isMember(resource.data.companyId);
      // Any member may start watching a tender. The ID is tied to the
      // company, so one company cannot take another company's bid ID.
      allow create: if isMember(request.resource.data.companyId)
        && bidId == request.resource.data.companyId + '_'
          + request.resource.data.tenderId
        && newBidIsUnapproved();
      // Only the owner approves: see bidManagerMayUpdate. createdAt never
      // changes, so a fresh bid written over an existing one (a stale
      // "Watch this tender") is refused instead of wiping its progress.
      allow update: if isMember(resource.data.companyId)
        && unchanged(['id', 'companyId', 'tenderId', 'createdAt'])
        && (isOwner(resource.data.companyId) || bidManagerMayUpdate());
      allow delete: if isOwner(resource.data.companyId);
    }

    // Owner only, append-only.
    match /approvals/{approvalId} {
      allow read: if isMember(resource.data.companyId);
      allow create: if isOwner(request.resource.data.companyId)
        && request.resource.data.by == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
