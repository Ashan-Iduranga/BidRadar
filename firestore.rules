rules_version = '2';

// BidRadar Firestore security rules (Phase 1: roles and invites).
// Model: one company per account. companies/{id}.members is a map
// uid -> "owner" | "bid_manager". Only members read company data;
// only the owner edits the profile and writes approvals.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function company(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId)).data;
    }

    function isMember(companyId) {
      return signedIn() && request.auth.uid in company(companyId).members;
    }

    function isOwner(companyId) {
      return signedIn() && company(companyId).ownerUid == request.auth.uid;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    // The caller holds an invite to this company.
    function invitedTo(companyId) {
      let path = /databases/$(database)/documents/invites/$(myEmail());
      return signedIn() && exists(path)
        && get(path).data.companyId == companyId;
    }

    // users/{uid}: which company the user belongs to. Pointing it at a
    // company you are not a member of grants nothing.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // invites/{email}: owner invites a bid manager by email.
    match /invites/{email} {
      allow read: if signedIn()
        && (myEmail() == email || isOwner(resource.data.companyId));
      allow create: if isOwner(request.resource.data.companyId)
        && request.resource.data.email == email
        && request.resource.data.role == 'bid_manager'
        && request.resource.data.invitedBy == request.auth.uid;
      allow delete: if signedIn()
        && (myEmail() == email || isOwner(resource.data.companyId));
      allow update: if false;
    }

    match /companies/{companyId} {
      allow read: if isMember(companyId);
      // The creator must name themself as owner and owner-member.
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.members[request.auth.uid] == 'owner';
      allow update: if (isOwner(companyId)
          && request.resource.data.ownerUid == resource.data.ownerUid)
        // An invited user may add only themself, only as bid manager.
        || (invitedTo(companyId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['members', 'memberEmails'])
          && request.resource.data.members.diff(resource.data.members)
               .affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.members[request.auth.uid] == 'bid_manager'
          && request.resource.data.memberEmails.diff(resource.data.memberEmails)
               .affectedKeys().hasOnly([request.auth.uid]));
      allow delete: if false;
    }

    match /profiles/{companyId} {
      allow read: if isMember(companyId);
      allow write: if isOwner(companyId);
    }

    // Public tender data, shared across companies. Written by the app's sync.
    match /tenders/{tenderId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if false;
    }

    // Audit trail: append-only.
    match /verdicts/{verdictId} {
      allow read: if isMember(resource.data.companyId);
      allow create: if isMember(request.resource.data.companyId);
      allow update, delete: if false;
    }

    match /bids/{bidId} {
      allow read: if isMember(resource.data.companyId);
      allow create: if isMember(request.resource.data.companyId);
      // Members update bids, but only the owner approves: a bid manager may
      // only ask (approval -> 'pending') and cannot leave 'watching' until
      // the owner has approved.
      allow update: if isMember(resource.data.companyId)
        && request.resource.data.companyId == resource.data.companyId
        && (isOwner(resource.data.companyId)
          || ((request.resource.data.approval == resource.data.approval
                || request.resource.data.approval == 'pending')
            && (resource.data.stage != 'watching'
                || request.resource.data.stage == 'watching')));
      allow delete: if isOwner(resource.data.companyId);
    }

    // Owner only, append-only.
    match /approvals/{approvalId} {
      allow read: if isMember(resource.data.companyId);
      allow create: if isOwner(request.resource.data.companyId)
        && request.resource.data.by == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
