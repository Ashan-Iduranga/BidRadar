{
  "name": "bidradar-rules-test",
  "private": true,
  "description": "Firestore security rules tests, run on the local emulator. Needs Java 21 or newer.",
  "type": "module",
  "scripts": {
    "test": "firebase emulators:exec --only firestore --project demo-bidradar --config ../../firebase.json \"node --test rules.test.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.4.0",
    "firebase-tools": "15.37.0"
  }
}
